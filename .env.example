# Copy to .env and fill in. Never commit real values.
# Vercel-managed values (DATABASE_URL*, BLOB_READ_WRITE_TOKEN) are pulled into
# .env.local with `vercel env pull .env.local`.

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Vercel Blob read/write token (listing photos)
BLOB_READ_WRITE_TOKEN="your-blob-token"

# Auth.js session encryption secret: generate with `npx auth secret`
AUTH_SECRET="your-auth-secret"

# Comma-separated, exact-match email domains allowed to sign up
ALLOWED_EMAIL_DOMAINS="sst.scaler.com,example.edu"

# "off" (default): campus-domain check at sign-up only, accounts active immediately.
# "required": new accounts must enter a 6-digit code sent over SMTP (configure SMTP_* below).
EMAIL_VERIFICATION="off"

# SMTP for verification emails (Gmail: smtp.gmail.com / 465 / your Gmail address / a 16-char App Password).
# If left as placeholders in development, codes are printed to the server log instead.
SMTP_HOST="your-smtp-host"
SMTP_PORT="465"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-app-password"
EMAIL_FROM="your-from-address"
